{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Miracle2008-png/wakeup-launcher/theme-dna/schema.json",
  "title": "WakeUp Theme DNA v0.1",
  "type": "object",
  "required": ["dna", "id", "name", "intensity", "world", "palette", "type", "motion"],
  "properties": {
    "dna": { "const": "0.1" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "describe": { "type": "string", "description": "One plain line for screen readers, read once on apply" },
    "parent": { "type": "string", "description": "id@version this was remixed from; originals are immutable" },
    "intensity": {
      "type": "object",
      "required": ["default", "ceiling"],
      "properties": {
        "default": { "type": "integer", "minimum": 0, "maximum": 3 },
        "ceiling": { "type": "integer", "minimum": 0, "maximum": 4 }
      }
    },
    "world": {
      "type": "object",
      "required": ["layers"],
      "properties": {
        "span": { "type": "number", "minimum": 1, "maximum": 2, "description": "World width in screen widths; above 1 makes pages a pan across one scene" },
        "layers": {
          "type": "array", "minItems": 1, "maxItems": 9,
          "items": {
            "type": "object",
            "required": ["id", "source", "parallax"],
            "properties": {
              "id": { "type": "string" },
              "source": { "enum": ["bitmap", "shader", "particles", "video", "procedural"] },
              "ref": { "type": "string" },
              "parallax": { "type": "number", "minimum": 0, "maximum": 0.03 },
              "wind": { "type": "number", "minimum": 0, "maximum": 1 },
              "lightResponse": { "type": "number", "minimum": 0, "maximum": 1 },
              "minIntensity": { "type": "integer", "minimum": 0, "maximum": 4 }
            }
          }
        }
      }
    },
    "time": {
      "type": "object",
      "description": "Keyframes on 0..1 (0 is dawn), interpolated in OKLCH",
      "properties": {
        "keys": {
          "type": "array",
          "items": {
            "type": "object", "required": ["t"],
            "properties": {
              "t": { "type": "number", "minimum": 0, "maximum": 1 },
              "key": { "type": "string" }, "ambient": { "type": "string" },
              "warmth": { "type": "number" }, "sky": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "weather": {
      "type": "object",
      "properties": {
        "rain": { "$ref": "#/$defs/response" }, "fog": { "$ref": "#/$defs/response" },
        "cloud": { "$ref": "#/$defs/response" }, "snow": { "$ref": "#/$defs/response" },
        "wind": { "$ref": "#/$defs/response" }
      }
    },
    "device": {
      "type": "object",
      "properties": {
        "charging": { "type": "string" }, "batteryLow": { "type": "string" },
        "headphones": { "type": "string" }, "music": { "type": "string" }, "focus": { "type": "string" }
      }
    },
    "palette": {
      "type": "object",
      "required": ["ink", "surface", "accent"],
      "properties": {
        "ink": { "type": "string" }, "surface": { "type": "string" }, "accent": { "type": "string" },
        "grade": { "type": "object", "properties": { "shadowHue": { "type": "number" }, "chromaCap": { "type": "number" } } }
      }
    },
    "type": {
      "type": "object", "required": ["clock", "ui"],
      "properties": {
        "clock": { "type": "object", "properties": { "family": { "type": "string" }, "style": { "enum": ["cinematic", "minimal", "editorial", "practical"] }, "weight": { "type": "number" } } },
        "ui": { "type": "object", "properties": { "family": { "type": "string" } } }
      }
    },
    "motion": {
      "type": "object", "required": ["reasons"],
      "properties": {
        "page": { "enum": ["slide", "pan", "fade"] },
        "reasons": { "type": "object", "description": "Every moving element must justify itself", "additionalProperties": { "type": "string", "minLength": 8 } }
      }
    },
    "materials": { "type": "object", "additionalProperties": { "enum": ["air", "matte", "frost", "lacquer", "etched"] } },
    "widgets": { "type": "object" },
    "icons": { "type": "object", "properties": { "treatment": { "enum": ["original", "light", "mono", "glass-edge"] }, "pack": { "type": "string" } } },
    "sound": {
      "type": "object",
      "properties": {
        "ambient": { "type": "string" }, "interaction": { "type": "string" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "whileLocked": { "const": false, "description": "Not configurable. A locked device never makes WakeUp sounds." }
      }
    },
    "haptics": { "type": "object", "properties": { "tick": { "type": "boolean" }, "settle": { "type": "boolean" }, "confirm": { "type": "boolean" }, "soft": { "type": "boolean" } } },
    "layout": { "type": "object", "properties": { "grid": { "type": "array", "items": { "type": "integer" } }, "dock": { "type": "integer" } } },
    "interactions": { "type": "object" },
    "moments": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "cooldownMin", "probability", "minIntensity"],
        "properties": {
          "id": { "type": "string" }, "trigger": { "type": "string" },
          "cooldownMin": { "type": "number", "minimum": 25 },
          "probability": { "type": "number", "maximum": 0.2 },
          "durationS": { "type": "number" }, "minIntensity": { "type": "integer", "minimum": 2 }
        }
      }
    },
    "modes": { "type": "object", "description": "Named partial overrides of this DNA", "additionalProperties": { "type": "object" } }
  },
  "$defs": {
    "response": { "type": "object", "properties": { "layer": { "type": "string" }, "gain": { "type": "number" }, "max": { "type": "number" } } }
  }
}
